{
  "name": "dsh-botcrew",
  "version": "0.1.2",
  "description": "BotCrew — run WorkBuddy and QwenWork from one DSH group chat, with members, permissions, artifacts and a live work panel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "src",
    "group-chat.html",
    "config.json",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "harness",
    "botcrew",
    "bot",
    "workbuddy",
    "qwen",
    "office",
    "agent",
    "group-chat",
    "mcp"
  ],
  "license": "MIT",
  "author": "BotCrew contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hankniu77/dsh-botcrew.git"
  },
  "homepage": "https://github.com/hankniu77/dsh-botcrew#readme",
  "bugs": {
    "url": "https://github.com/hankniu77/dsh-botcrew/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}

